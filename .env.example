# LangSmith 追踪配置模板
#
# 使用步骤：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 打开 https://smith.langchain.com/settings 登录你的账号
#   3. 在 API Keys 页面创建一个新 Key（形如 lsv2_xxxx...），粘贴到下面
#   4. 保存后运行程序即可，无需再手动 export
#
# .env 文件已被 .gitignore 忽略，不会提交到仓库，放心填写。

# 打开 LangSmith 追踪
LANGCHAIN_TRACING_V2=true

# 你的 LangSmith API Key（在 smith.langchain.com 生成）
LANGCHAIN_API_KEY=

# 可选：项目名（不填默认用 blog_writer）
LANGCHAIN_PROJECT=blog_writer
